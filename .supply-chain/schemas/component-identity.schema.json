{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convexa.local/supply-chain/component-identity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "ecosystem", "name", "version", "provenance"],
  "properties": {
    "family": { "enum": ["convexa-workspace", "cargo-normal-build", "npm-production-closure"] },
    "ecosystem": { "enum": ["cargo", "npm"] },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "integrity", "path", "manifest_sha256"],
          "properties": {
            "kind": { "const": "registry" },
            "source": { "type": "string", "minLength": 1, "maxLength": 512 },
            "integrity": { "type": "string", "minLength": 1, "maxLength": 512 },
            "path": { "type": "null" },
            "manifest_sha256": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "integrity", "path", "manifest_sha256"],
          "properties": {
            "kind": { "const": "workspace" },
            "source": { "const": "workspace" },
            "integrity": { "type": "null" },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
            },
            "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    }
  }
}
