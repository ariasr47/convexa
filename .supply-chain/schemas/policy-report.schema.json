{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convexa.local/supply-chain/policy-report.schema.json",
  "$defs": {
    "safe_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullable_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "rule_id": { "$ref": "#/$defs/safe_id" },
        "reason_code": { "$ref": "#/$defs/safe_id" },
        "target": { "$ref": "#/$defs/safe_id" },
        "count": { "type": "integer", "minimum": 0 },
        "shown": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "evidence_short_sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "current_short_sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "digest": { "$ref": "#/$defs/digest" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "authority",
        "required",
        "scope",
        "tool",
        "tool_version",
        "advisory_data_revision",
        "state",
        "completion",
        "rule_id",
        "reason_code",
        "reason_params",
        "finding_count",
        "evidence_sha256"
      ],
      "properties": {
        "check_id": { "$ref": "#/$defs/safe_id" },
        "authority": { "$ref": "#/$defs/safe_id" },
        "required": { "const": true },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "tool": { "$ref": "#/$defs/safe_id" },
        "tool_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "advisory_data_revision": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        },
        "state": { "enum": ["pass", "pass_with_advisories", "fail", "blocked", "skipped"] },
        "completion": {
          "enum": [
            "complete",
            "failed_to_start",
            "timed_out",
            "unavailable",
            "malformed",
            "partial",
            "authorized_skip"
          ]
        },
        "rule_id": { "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }] },
        "reason_code": { "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }] },
        "reason_params": { "$ref": "#/$defs/params" },
        "finding_count": { "type": "integer", "minimum": 0 },
        "evidence_sha256": { "$ref": "#/$defs/nullable_sha256" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "check_id",
        "rule_id",
        "classification",
        "subject_kind",
        "subject",
        "message_code",
        "message_params",
        "owner_id",
        "action_code",
        "evidence_ref",
        "rationale",
        "approver_id",
        "review_at",
        "expires_at",
        "exception_id"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/safe_id" },
        "check_id": { "$ref": "#/$defs/safe_id" },
        "rule_id": { "$ref": "#/$defs/safe_id" },
        "classification": { "enum": ["blocker", "advisory"] },
        "subject_kind": { "enum": ["repo_path", "package", "digest"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 240 },
        "message_code": { "$ref": "#/$defs/safe_id" },
        "message_params": { "$ref": "#/$defs/params" },
        "owner_id": { "$ref": "#/$defs/safe_id" },
        "action_code": { "$ref": "#/$defs/safe_id" },
        "evidence_ref": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^artifact:[a-z0-9][a-z0-9._-]{0,63}(#/(?:[A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+)?$"
        },
        "rationale": { "type": ["string", "null"], "maxLength": 512 },
        "approver_id": { "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }] },
        "review_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "expires_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "exception_id": { "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_kind",
        "digest",
        "revision_sha",
        "run_key",
        "build_run_id",
        "source_inputs_sha256",
        "scan_artifact_id",
        "dependency_inventory_artifact_id",
        "inventory_receipt_artifact_id"
      ],
      "properties": {
        "subject_id": { "enum": ["api-production-image", "dashboard-distribution-archive"] },
        "subject_kind": { "enum": ["oci_image", "file_archive"] },
        "digest": { "$ref": "#/$defs/digest" },
        "revision_sha": { "$ref": "#/$defs/git_sha" },
        "run_key": { "$ref": "#/$defs/sha256" },
        "build_run_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
        "source_inputs_sha256": { "$ref": "#/$defs/sha256" },
        "scan_artifact_id": { "oneOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }] },
        "dependency_inventory_artifact_id": { "$ref": "#/$defs/safe_id" },
        "inventory_receipt_artifact_id": { "$ref": "#/$defs/safe_id" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "file_name",
        "media_type",
        "sha256",
        "size_bytes",
        "created_at",
        "retention_days",
        "expires_at"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/safe_id" },
        "kind": {
          "enum": [
            "policy_report",
            "capability_receipts",
            "toolchain_receipt",
            "scan_report",
            "component_oracle",
            "subject_archive",
            "dependency_inventory",
            "dependency_inventory_receipt",
            "summary"
          ]
        },
        "file_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown",
            "application/vnd.cyclonedx+json",
            "application/x-tar"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "retention_days": { "const": 30 },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "revision_sha",
    "event",
    "path",
    "run_key",
    "policy_sha256",
    "created_at",
    "retention_days",
    "complete",
    "aggregate",
    "toolchain",
    "checks",
    "findings",
    "exceptions",
    "subjects",
    "redaction",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_kind": { "const": "supply_chain_policy" },
    "revision_sha": { "$ref": "#/$defs/git_sha" },
    "event": { "enum": ["pull_request", "default_branch", "schedule", "workflow_dispatch"] },
    "path": { "enum": ["policy", "artifacts"] },
    "run_key": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "retention_days": { "const": 30 },
    "complete": { "type": "boolean" },
    "aggregate": { "enum": ["pass", "pass_with_advisories", "fail", "blocked"] },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "rust"],
      "properties": {
        "node": { "type": "string", "minLength": 1, "maxLength": 64 },
        "npm": { "type": "string", "minLength": 1, "maxLength": 64 },
        "rust": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "exceptions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safe_id" } },
    "subjects": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/subject" } },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "kinds"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "snippet",
              "authorization",
              "url_userinfo",
              "url_query",
              "environment",
              "command",
              "filename",
              "control_character"
            ]
          }
        }
      }
    },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
  }
}
