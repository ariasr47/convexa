{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convexa.local/supply-chain/inventory-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "subject_id",
    "subject_kind",
    "subject_digest",
    "revision_sha",
    "run_key",
    "build_run_id",
    "builder",
    "generator",
    "inventory_basis",
    "association_kind",
    "subject_bytes_observed_by_generator",
    "format",
    "schema_version_declared",
    "inventory_sha256",
    "policy_sha256",
    "validation",
    "component_families",
    "component_count",
    "component_oracle_sha256",
    "component_identity_set_sha256",
    "required_seed_count",
    "required_seeds_present",
    "source_inputs_sha256",
    "byte_scan_evidence_sha256",
    "archive_validation_sha256",
    "complete"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_kind": { "const": "associated_dependency_inventory" },
    "subject_id": { "enum": ["api-production-image", "dashboard-distribution-archive"] },
    "subject_kind": { "enum": ["oci_image", "file_archive"] },
    "subject_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "build_run_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
    "builder": { "const": "github-actions-ubuntu-24.04" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "syft" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "inventory_basis": { "const": "lock_derived" },
    "association_kind": { "const": "named_subject_digest" },
    "subject_bytes_observed_by_generator": { "const": false },
    "format": { "const": "CycloneDX 1.6 JSON dependency inventory" },
    "schema_version_declared": { "const": "1.6" },
    "inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "validation": { "enum": ["pass", "fail", "blocked"] },
    "component_families": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["convexa-workspace", "cargo-normal-build", "npm-production-closure"] }
    },
    "component_count": { "type": "integer", "minimum": 1 },
    "component_oracle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "component_identity_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "required_seed_count": { "type": "integer", "minimum": 1 },
    "required_seeds_present": { "const": true },
    "source_inputs_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "byte_scan_evidence_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "archive_validation_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "complete": { "const": true }
  }
}
