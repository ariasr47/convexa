{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/cypress",
    "sourceMap": false,
    "types": ["cypress", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "cypress.config.ts",
    "src/**/*.cy.ts",
    "src/**/*.d.ts",
    "src/support/**/*.ts"
  ],
  "exclude": ["out-tsc", "dist", "cypress"]
}
