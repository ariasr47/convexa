{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["**/*.ts", "**/*.js", "playwright.config.ts", "src/**/*.spec.ts", "src/**/*.d.ts"],
  "exclude": ["out-tsc", "dist", "test-output", "playwright-report", "test-results"]
}
