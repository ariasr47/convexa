+        status: 'open',
+      });
+      hook.unmount();
+    } finally {
+      vi.useRealTimers();
+    }
+    expect(localStorage.getItem('convexa.orders.v1')).toBeNull();
+    expect(localStorage.getItem('convexa.demo.v1.convexa.orders.v1')).not.toBeNull();
