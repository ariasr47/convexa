+  const putGex = strikes.reduce((sum, strike) => sum + strike.put_gex, 0);
+  const callDex = strikes.reduce((sum, strike) => sum + (strike.call_dex ?? 0), 0);
+  const putDex = strikes.reduce((sum, strike) => sum + (strike.put_dex ?? 0), 0);
