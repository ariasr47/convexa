+  const callQuote = sampleContractQuote(spot, atmStrike, 'call', selectedDte);
+  const putQuote = sampleContractQuote(spot, atmStrike, 'put', selectedDte);
+  const straddlePrice = Number((callQuote.mid + putQuote.mid).toFixed(2));
