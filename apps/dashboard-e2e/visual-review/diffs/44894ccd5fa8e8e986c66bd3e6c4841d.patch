+        for (const strike of [
+          ...new Set([
+            ...seededStrikes,
+            Math.floor(spot / 5) * 5 - 5,
+            Math.floor(spot / 5) * 5,
+            Math.floor(spot / 5) * 5 + 5,
+          ]),
+        ]) {
+          for (const right of ['call', 'put'] as const) {
+            const dte = expiration === '2026-10-09' ? 2 : expiration === '2026-10-16' ? 9 : 44;
