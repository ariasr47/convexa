+  interval = undefined;
+}
+function invalidateFrames() {
+  frameGeneration++;
+}
+function pauseForStorageFault() {
+  storageUnavailable = true;
+  playback = 'paused';
+  invalidateFrames();
+  stopTimer();
+  emitClock();
+}
+function startTimer() {
+  if (interval || observers.size + frameObservers.size === 0 || playback !== 'running') return;
+  interval = setInterval(() => {
