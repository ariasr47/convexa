+export type IndicatorName = 'ema20' | 'ema50' | 'rsi14' | 'adx14' | 'atr14';
+export type IndicatorPoint =
+  | {
+      state: 'ready';
+      value: number;
+      sourceBarId: string;
+      method: string;
+      window: number;
+      basis: string;
+      unit: 'USD' | 'index';
+    }
+  | {
