index 0000000000000000000000000000000000000000..1d3ffb6871bc32c2cbc3a4cb9bd5fdad319be1a0
--- /dev/null
+++ b/apps/dashboard-e2e/tools/lib/process.mjs
@@ -0,0 +1,28 @@
+import { spawn } from 'node:child_process';
+import path from 'node:path';
+
+export function npmInvocation({
+  platform = process.platform,
+  execPath = process.execPath,
+  npmCliPath = null,
+  args = [],
+} = {}) {
+  if (platform === 'win32') {
+    if (!npmCliPath || !path.isAbsolute(npmCliPath)) {
+      throw new Error('Windows npm CLI path must be absolute and present');
+    }
+    return { command: execPath, args: [npmCliPath, ...args], shell: false };
+  }
+  return { command: 'npm', args: [...args], shell: false };
+}
+
+export function spawnCommand(command, args, options = {}) {
+  return new Promise((resolve) => {
+    const child = spawn(command, args, { ...options, shell: false });
+    let error;
+    child.once('error', (value) => {
+      error = value;
+    });
+    child.once('close', (code) => resolve({ exit_code: code ?? 1, error: error?.message ?? null }));
+  });
+}
diff --git a/apps/dashboard-e2e/tools/lib/repository-root.mjs b/apps/dashboard-e2e/tools/lib/repository-root.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b400a3817fdb2277e0d28bceca23395c76ad5e9e
--- /dev/null
+++ b/apps/dashboard-e2e/tools/lib/repository-root.mjs
@@ -0,0 +1,25 @@
+import fs from 'node:fs';
+import path from 'node:path';
+
+const EXPECTED_PACKAGE = '@convexa/source';
+
+export function repositoryRoot(moduleDirectory, parentCount = 3) {
+  const root = path.resolve(moduleDirectory, ...Array.from({ length: parentCount }, () => '..'));
+  const packagePath = path.join(root, 'package.json');
+  const manifestPath = path.join(root, 'apps', 'dashboard-e2e', 'src', 'quality', 'manifest.json');
+  if (!fs.existsSync(packagePath) || !fs.existsSync(manifestPath))
+    throw new Error('browser quality repository root is missing its package or manifest');
+  let packageJson;
+  try {
+    packageJson = JSON.parse(fs.readFileSync(packagePath, 'utf8'));
+  } catch {
+    throw new Error('browser quality repository root has an unreadable package.json');
+  }
+  if (packageJson.name !== EXPECTED_PACKAGE || packageJson.private !== true)
+    throw new Error('browser quality repository root is not the Convexa workspace');
+  return root;
+}
+
+// This helper lives one directory below the tools directory, so it needs one
+// additional hop compared with modules directly under tools/.
+export const ROOT = repositoryRoot(import.meta.dirname, 4);
