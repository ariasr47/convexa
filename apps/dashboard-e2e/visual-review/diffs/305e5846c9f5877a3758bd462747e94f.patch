--- /dev/null
+++ b/apps/dashboard-e2e/tools/run-gate.mjs
@@ -0,0 +1,64 @@
+import { spawn, spawnSync } from 'node:child_process';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { npmInvocation } from './lib/process.mjs';
+
+const target = process.argv[2];
+const configs = {
+  chromium: 'playwright.config.ts',
+  compatibility: 'playwright.compat.config.ts',
+  accessibility: 'playwright.a11y.config.ts',
+  visual: 'playwright.visual.config.ts',
+};
+if (!configs[target] || process.argv.length !== 3) {
+  console.error('Unknown browser quality gate.');
+  process.exit(2);
+}
+const root = path.resolve(import.meta.dirname, '..');
+const cwd = path.resolve(root, '..', '..');
+const npmCliPath = path.join(
+  path.dirname(process.execPath),
+  'node_modules',
+  'npm',
+  'bin',
+  'npm-cli.js',
+);
+if (process.platform === 'win32' && !fs.existsSync(npmCliPath)) {
+  console.error(`[BLOCKED] browser prerequisites — npm CLI not found: ${npmCliPath}`);
+  process.exit(1);
+}
+const invocation = npmInvocation({
+  npmCliPath,
+  args: ['exec', '--', 'playwright', 'test', '--config', path.join(root, configs[target])],
+});
+const artifactRoot = path.join(cwd, 'apps/dashboard-e2e/test-output/playwright', target);
+fs.rmSync(artifactRoot, { recursive: true, force: true });
+const revisionResult = spawnSync('git', ['rev-parse', 'HEAD'], {
+  cwd,
+  encoding: 'utf8',
+  shell: false,
+});
+const sourceRevision =
+  process.env.BROWSER_QUALITY_SOURCE_REVISION ??
+  (revisionResult.status === 0 ? revisionResult.stdout.trim() : '0'.repeat(40));
+const child = spawn(invocation.command, invocation.args, {
+  cwd,
+  stdio: 'inherit',
+  shell: invocation.shell,
+  env: {
+    ...process.env,
+    PLAYWRIGHT_UPDATE_SNAPSHOTS: 'none',
+    BROWSER_QUALITY_RUN_ID:
+      process.env.BROWSER_QUALITY_RUN_ID ??
+      `local-${Date.now()}-${crypto.randomBytes(4).toString('hex')}`,
+    BROWSER_QUALITY_SOURCE_REVISION: sourceRevision,
+  },
+});
+child.on('error', (error) => {
+  console.error(`[BLOCKED] browser prerequisites — ${error.message}`);
+  process.exitCode = 1;
+});
+child.on('close', (code) => {
+  process.exitCode = code ?? 1;
+});
diff --git a/apps/dashboard-e2e/tools/run-quality.mjs b/apps/dashboard-e2e/tools/run-quality.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..05d598f34e1a8cc8dd5ee9307c7afc1a5a7251b2
--- /dev/null
+++ b/apps/dashboard-e2e/tools/run-quality.mjs
@@ -0,0 +1,66 @@
+import { execFileSync, spawn } from 'node:child_process';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { CHILDREN, validateChildCatalog } from './lib/aggregate.mjs';
+
+if (process.argv.length !== 2) {
+  console.error('browser quality aggregate accepts no arguments');
+  process.exit(2);
+}
+validateChildCatalog();
+const targets = CHILDREN.map(({ target }) => target);
+const runId = process.env.BROWSER_QUALITY_RUN_ID ?? crypto.randomUUID();
+const source =
+  process.env.BROWSER_QUALITY_SOURCE_REVISION ??
+  execFileSync('git', ['rev-parse', 'HEAD'], {
+    cwd: path.resolve(import.meta.dirname, '..', '..'),
+    encoding: 'utf8',
+  }).trim();
+const command = process.platform === 'win32' ? 'npx.cmd' : 'npx';
+const cwd = path.resolve(import.meta.dirname, '..', '..');
+const children = targets.map(
+  (target, index) =>
+    new Promise((resolve) => {
+      const child = spawn(command, ['nx', 'run', target, '--skip-nx-cache'], {
+        cwd,
+        shell: false,
+        stdio: 'inherit',
+        env: {
+          ...process.env,
+          NX_DAEMON: 'false',
+          BROWSER_QUALITY_RUN_ID: runId,
+          BROWSER_QUALITY_SOURCE_REVISION: source,
+          BROWSER_QUALITY_PORT: String(4210 + index),
+        },
+      });
+      child.once('error', (error) => resolve({ target, exit_code: 1, error: error.message }));
+      child.once('close', (code) => resolve({ target, exit_code: code ?? 1 }));
+    }),
+);
+const results = await Promise.allSettled(children);
+const failed = results.some(
+  (result) => result.status !== 'fulfilled' || result.value.exit_code !== 0,
+);
+const output = path.join(cwd, 'apps/dashboard-e2e/test-output/playwright/quality');
+fs.mkdirSync(output, { recursive: true });
+fs.writeFileSync(
+  path.join(output, 'summary.json'),
+  JSON.stringify(
+    {
+      schema_version: 1,
+      gate: 'quality',
+      run_id: runId,
+      source_revision: source,
+      status: failed ? 'fail' : 'pass',
+      children: results.map((r) =>
+        r.status === 'fulfilled'
+          ? { ...r.value, execution_key: `${runId}:${r.value.target}`, invocation_count: 1 }
+          : { status: 'rejected' },
+      ),
+    },
+    null,
+    2,
+  ) + '\n',
+);
+process.exitCode = failed ? 1 : 0;
