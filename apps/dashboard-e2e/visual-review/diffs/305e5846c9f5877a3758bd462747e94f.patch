+  assert.equal(manifest.support_policy_id, 'playwright-engines-1.62.1');
+  assert.deepEqual(Object.keys(manifest.artifact_roots).sort(), [
+    'accessibility',
+    'chromium',
+    'compatibility',
+    'visual',
+  ]);
+  assert.equal(manifest.visual.threshold, 0);
+});
