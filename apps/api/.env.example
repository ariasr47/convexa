# Convexa backend — environment TEMPLATE (documentation only).
# ----------------------------------------------------------------------------
# Copy to apps/api/.env and fill in YOUR values:   cp .env.example .env
# This file contains NO secret values — only the var NAMES + what they do. It is
# committed as documentation; the real .env is gitignored and is NEVER baked into
# any image (docker-compose injects it at runtime via env_file).
#
# Every var below is OPTIONAL at boot — absent values degrade gracefully (no
# crash): no MASSIVE_API_KEY -> provider errors per existing behavior; no
# ANTHROPIC_API_KEY -> in-app AI rec `unavailable:no_key` (manual export floor
# still works); no Google creds -> "Continue with Google" present-but-disabled;
# no signing/encryption key -> ephemeral per-process key (resets on restart).
# Defaults shown in (parentheses) are the code defaults — leave a line blank/unset
# to take the default; do NOT put a value here.
# ----------------------------------------------------------------------------

# --- Market data vendor (Massive / Polygon-style) ---
MASSIVE_API_KEY=
DATA_FEED=                       # realtime | delayed
DATA_PROVIDER=                   # provider selector (default: massive)

# --- Polling / freshness / gate / live / dark-pool / vol-OI / tiers ---
CACHE_TTL_SECONDS=               # (60)  in-memory bundle cache TTL
STALE_AFTER_SECONDS=             # (120) snapshot age beyond which data is flagged stale
GATE_SCORE=                      # (50)  opportunity_score at/above which the AI gate opens
FLOW_WINDOW_SECONDS=             # (300) rolling net-flow window
LIVE_THROTTLE_SECONDS=           # (1.5) SSE broadcast cadence
CHAIN_REFRESH_SECONDS=           # (120) live chain re-fetch cadence
CHAIN_PREWARM_MAX_AGE_SECONDS=   # chain pre-warm freshness budget (clamped <= min(refresh, stale))
INCLUDE_DARK_POOL=               # (true) include off-exchange context by default
DARKPOOL_LOOKBACK_SECONDS=       # (3600) bounded off-exchange window
BLOCK_MIN_SHARES=                # (5000) institutional-size threshold for a block print
VOL_OI_UNUSUAL_THRESHOLD=        # (1.0)  vol/OI ratio above which a strike reads "unusual"
TIER_WATCH_SCORE=                # (25)   opportunity-tier band: watch
TIER_ACTIONABLE_SCORE=           # (=GATE_SCORE) band: actionable
TIER_PRIME_SCORE=                # (75)   band: prime (also requires ai_eval.ready)

# --- Backend observability (operator-only; off => bundle byte-identical) ---
OBSERVABILITY_ENABLED=           # (true)
METRICS_WINDOW_SIZE=             # (500)  rolling-window request count
METRICS_RECENT_TRACES=           # (25)
METRICS_SECRET_TOKEN=            # operator token gating GET /api/_metrics. UNSET (default) => the
                                 #          endpoint is OPEN (local-dev behavior unchanged). *** PROD
                                 #          MUST set it *** (the Railway *.up.railway.app origin is
                                 #          internet-reachable and the readout leaks operator
                                 #          diagnostics). When set, the request must present it via
                                 #          `Authorization: Bearer <token>` OR the `X-Metrics-Token`
                                 #          header, else 401. (system-6 HIGH-1)

# --- Public-endpoint abuse / vendor-cost throttle (per-IP, per-minute) ---
PUBLIC_RATE_LIMIT_PER_MIN=       # in-memory per-IP per-minute cap on the anonymous, vendor-cost-
                                 #          bearing /api/ticker/* + /api/stream/* (over the limit =>
                                 #          429 + Retry-After, NO vendor call). UNSET / 0 / a disable
                                 #          value (off|none|disabled|false|no) => OFF (local dev
                                 #          unchanged). Process-local (per-replica). Recommended prod
                                 #          value ~30. Best-effort + fail-open + outside the scoring
                                 #          path. Client IP is read behind the proxy in this order:
                                 #          CF-Connecting-IP -> first hop of X-Forwarded-For -> socket
                                 #          peer. (system-6 HIGH-2)

# --- In-app AI recommendations (server-side key; never in the browser) ---
ANTHROPIC_API_KEY=
AI_REC_MODEL=                    # latest Claude
AI_REC_COOLDOWN_SECONDS=         # (60)
AI_REC_DAILY_CAP=                # (50)   global shared-key daily cap
AI_REC_TIMEOUT_SECONDS=          # (60)
AI_REC_IN_APP_ENABLED=           # (true)
AI_REC_STUB=                     # (off)  stub LLM provider for keyless/no-cost verification

# --- User accounts (auth + sessions) ---
ACCOUNT_STORE=                   # (memory) store backend: memory (default, in-memory SQLite, resets
                                 #          on restart) | postgres (persistent — see persistent-db block below)
AUTH_SESSION_SIGNING_KEY=        # server-side HMAC key for the session cookie (absent => ephemeral
                                 #          per-process). *** MUST be set + STABLE when ACCOUNT_STORE=postgres ***
                                 #          (see the persistent-db block below) — else sessions silently
                                 #          drop to anonymous after every restart/deploy.
GOOGLE_CLIENT_ID=                # absent => "Continue with Google" present-but-disabled
GOOGLE_CLIENT_SECRET=            # server-side only; never reaches the browser
GOOGLE_REDIRECT_URI=

# --- Bring-your-own AI key (per-user encrypted Anthropic key) ---
AI_KEY_ENCRYPTION_KEY=           # server-side Fernet key (absent => ephemeral per-process; stored
                                 #          keys reset on restart). *** MUST be set + STABLE when
                                 #          ACCOUNT_STORE=postgres *** (see persistent-db block) — else
                                 #          the now-durable encrypted AI keys become UNDECRYPTABLE after a
                                 #          restart (users must re-enter their key) and differ per replica.
AI_REC_ADMIN_EMAILS=             # comma-separated admin allowlist that gets the shared-key free allowance
AI_REC_ADMIN_FREE_DAILY=         # (3) per-admin daily free allowance on the shared key

# --- Persistent DB (Postgres auth store — persistent-db; OPT-IN, server-side only) ---
# Set ACCOUNT_STORE=postgres (above) to persist accounts / sessions / per-user settings / encrypted
# AI keys across restarts + replicas. The DB stores ONLY ciphertext + the masked last4 for AI keys —
# never plaintext, never the encryption secret ([secret-encrypted-at-rest]). DATABASE_URL is read at
# RUNTIME only and is NEVER committed or baked into an image ([no-secrets-in-image]); the real .env is
# gitignored + .dockerignore'd. Leave ACCOUNT_STORE blank to keep the in-memory default (no DB needed).
DATABASE_URL=                    # REQUIRED ONLY when ACCOUNT_STORE=postgres. postgresql://user:pass@host:port/db
DATABASE_POOL_MAX=               # (10) max size of the process-wide connection pool (operator config)

# --- Scanner sweep store (Scanner v1). Mirrors IV_STORE. ---
SCAN_STORE=disk           # disk (default, on-disk sqlite under DATA_DIR) | postgres
# SCAN_DATABASE_URL=      # required when SCAN_STORE=postgres (falls back to DATABASE_URL); runtime env only
# SCAN_STORE_PATH=        # optional on-disk path override (default DATA_DIR/scan.sqlite3)
#
# --- Scanner sweep worker (Scanner v1 P2). All optional; D4 defaults shown. ---
# SCANNER_EMBEDDED=       # 1 => run the sweep loop inside the dev API process (one terminal). Prod uses the 2nd process.
# SCAN_UNIVERSE_PATH=     # override the checked-in universe JSON (default src/scanner/config/universe.json)
# SCAN_FAST_INTERVAL_SECONDS=30    # fast-lane snapshot poll cadence
# SCAN_STALE_AFTER_SECONDS=180     # structure freshness budget -> `stale`
# SCAN_MOVE_THRESHOLD_PCT=0.75     # move that promotes a symbol in the sweep queue
# SCAN_SLOW_BATCH_SIZE=4           # slow-lane concurrency (pool) = symbols computed per cycle
# SCAN_PROMOTION_CAP=2             # max promotions per cycle (anti-herd; < SCAN_SLOW_BATCH_SIZE)
#
# --- Scanner read API (Scanner v1 P3). All optional; defaults shown. ---
# SCAN_DEFAULT_VIEW_N=20            # default-view fallback size (top-N by score) when no explicit default_view list
# SCAN_WARM_MAX_AGE_SECONDS=120    # ticker warm-click freshness budget (clamped <= STALE_AFTER_SECONDS); older blob => miss
#
# *** STABLE-KEY REQUIREMENT for ACCOUNT_STORE=postgres (persistent-db ARCHITECTURE §8) ***
# In persistent mode the ciphertext + session rows SURVIVE restarts/deploys/replicas, so the two keys
# below MUST be set to STABLE values that are IDENTICAL across every restart and every replica:
#   - AI_KEY_ENCRYPTION_KEY     — else durable encrypted AI keys become undecryptable after a restart
#                                 (every resolution => "no usable key"; users must re-enter their key);
#                                 a different key per replica makes a key saved on A unreadable on B.
#   - AUTH_SESSION_SIGNING_KEY  — else signed session cookies become unverifiable after a restart
#                                 (every session silently => anonymous; users logged out on every deploy);
#                                 replicas can't validate each other's cookies.
# The ephemeral per-process fallback stays the keyless-local convenience for ACCOUNT_STORE=memory ONLY.

# --- Security fast-follows (system-6 review; hardened 2026-07-28) --------------------------------
# CORS allowlist, comma-separated. UNSET => DENY-ALL (fail-closed). This is correct for the deployed
# shape, where the Cloudflare Pages Function proxies /api/* so the browser is same-origin and CORS is
# never consulted. Set it only if a browser must call this API cross-origin.
#   prod example:  ALLOWED_ORIGINS=https://convexa.pages.dev
#   local example: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# NOTE: local dev does NOT need this — the dashboard dev server proxies /api to :8000 (same-origin).
ALLOWED_ORIGINS=

# Interactive API docs (Swagger /docs, ReDoc /redoc, /openapi.json). OPT-IN: unset => all three are
# DISABLED, so a deployment does not publish its full route list and schemas. Set to 1 locally when
# you want them.
ENABLE_API_DOCS=

# Session cookie Secure flag. MUST be true (or unset — true is the code default) in any deployment.
# Setting it false in production would transmit the session cookie over plain HTTP. Only ever set
# this false for local non-HTTPS work, and never copy that line into Railway Variables.
AUTH_COOKIE_SECURE=
