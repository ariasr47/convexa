# =============================================================================
# Convexa API (api-rust) — environment TEMPLATE (committed; NO secret values)
# =============================================================================
# Copy to a local secrets file (gitignored) and fill values:
#
#   cp apps/api/.env.example apps/api/.env
#
# Load order (see apps/api/src/main.rs load_dotenv):
#   1) apps/api/.env
#   2) else repo-root .env
#   3) else process cwd .env
# Process env / Railway Variables always win over files if already set.
#
# Multi-environment guidance: docs/ENVIRONMENTS.md
#   Recommended local files (all gitignored except *.example):
#     apps/api/.env              — your default local (usually APP_ENV=dev)
#     apps/api/.env.dev          — optional explicit dev overlay
#     apps/api/.env.test         — optional test overlay (CI / local gate suite)
#     apps/api/.env.prod.local   — optional read-only prod credentials for research
#                                 CLIs ONLY — never for serve() against prod DB
#                                 from a laptop without extreme care.
#
# Truth source for variable names: apps/api/src/config.rs + call sites.
# This file is documentation — blank lines take code defaults where noted.
# =============================================================================

# --- Identity / environment (convention; not all are wired in code yet) -------
# APP_ENV labels *which* stack this process belongs to. Use in docs, scripts,
# and host variable groups (Railway). Future loaders may auto-load .env.$APP_ENV.
APP_ENV=                         # dev | test | prod   (recommended)
# Optional human label for logs / metrics (e.g. railway-prod, laptop-rodrig).
# APP_INSTANCE=

# =============================================================================
# A. REQUIRED for live vendor / serve / join-outcomes
# =============================================================================
# Config::from_env() FAILS if MASSIVE_API_KEY is missing or empty (serve,
# join-outcomes, live chain paths). Offline unit tests and some stub paths do
# not go through that loader.
MASSIVE_API_KEY=                 # *** REQUIRED for live serve + join-outcomes ***
DATA_FEED=                       # realtime (default) | delayed
DATA_PROVIDER=                   # documentation / future multi-provider switch
                                 # (today: Massive is the live REST+WS vendor)
MASSIVE_REST_BASE=               # (https://api.massive.com) override for mocks/proxies

# =============================================================================
# B. Process bind / cache / warm
# =============================================================================
HTTP_BIND=                       # (0.0.0.0:8000)
REDIS_URL=                       # unset => in-process price cache; set for multi-replica
GEX_CACHE_TTL_SECS=              # (10)  ad-hoc tickers
GEX_CACHE_TTL_LIQUID_SECS=       # (20)  liquid/warm tickers (must be >= GEX_CACHE_TTL_SECS)
WARM_ENABLED=                    # (true) background GEX warmer on serve
WARM_SYMBOLS=                    # (SPY,QQQ,IWM,DIA,NVDA,AAPL,TSLA,MSFT,META,AMZN)
LIQUID_SYMBOLS=                  # (same default set) longer GEX TTL
WARM_INTERVAL_SECS=              # (25)
WARM_CONCURRENCY=                # (2)

# Legacy / UI-facing freshness knobs (may be read by residual paths; safe to leave blank)
CACHE_TTL_SECONDS=               # historical Python name — prefer GEX_CACHE_* above
STALE_AFTER_SECONDS=

# =============================================================================
# C. Scanner + structure-history (research capture spine)
# =============================================================================
# Samples for score-lab / join-outcomes are written on successful *slow-lane*
# structure recomputes into the scan store (not live price ticks).
# Verify: GET /api/health → scanner.board.history_samples
#          GET /api/scan/SPY/history?limit=5
SCAN_ENABLED=                    # (true) two-speed scanner on serve
SCAN_STORE=                      # disk|json (default local files under data/)
                                 # | postgres (uses SCAN_DATABASE_URL or DATABASE_URL)
                                 # *** for join-outcomes against prod history:
                                 #     SCAN_STORE=postgres + DATABASE_URL (or SCAN_DATABASE_URL)
                                 #     and a binary built with --features postgres
SCAN_DATABASE_URL=               # optional dedicated scan DB; else DATABASE_URL when SCAN_STORE=postgres
SCAN_STORE_PATH=                 # (data/scan.sqlite3 → normalized to data/scan.json for JSON store)
SCAN_UNIVERSE_PATH=              # (apps/api/config/universe.json)
SCAN_FAST_INTERVAL_SECS=         # (30)  note: code name is SECS not SECONDS
SCAN_SLOW_BATCH_SIZE=            # (4)
SCAN_PROMOTION_CAP=              # (2)
SCAN_STALE_AFTER_SECS=           # (180)
SCAN_MARKET_HOURS_ONLY=          # unset => ON (idle outside vendor hours). 0/false/off => always sweep
# SCANNER_EMBEDDED=              # host/deploy note: 1 = sweep inside API process (local one-terminal)

# IV history path (JSON when not on Postgres)
IV_STORE_PATH=                   # (data/iv_timeseries.json)

# =============================================================================
# D. Durable Postgres (auth + multi-instance scan/IV when features=postgres)
# =============================================================================
DATABASE_URL=                    # postgresql://user:pass@host:port/db
                                 # REQUIRED for ACCOUNT_STORE=postgres and for
                                 # SCAN_STORE=postgres when SCAN_DATABASE_URL unset.
DATABASE_POOL_MAX=               # (10)
# Auth durable store selection is implied by DATABASE_URL + --features postgres
# in the Rust deploy; local default is JSON/SQLite under data/.
AUTH_STORE_PATH=                 # (data/auth.sqlite3 / JSON sibling)

# Stable secrets when durable auth is on (MUST be identical across restarts/replicas):
AUTH_SESSION_SIGNING_KEY=        # HMAC for session cookie; unset => ephemeral (logout every restart)
AI_KEY_ENCRYPTION_KEY=           # Fernet-ish material for BYO AI keys; unset => ephemeral
AUTH_COOKIE_SECURE=              # (true) only set false for local HTTP
AUTH_COOKIE_SAMESITE=            # (lax)
AUTH_SESSION_IDLE_SECONDS=       # (7d)
AUTH_SESSION_ABSOLUTE_SECONDS=   # (30d)

# Registration (Rust name — not SIGNUPS_ENABLED)
AUTH_REGISTRATION_OPEN=          # unset/false => CLOSED (prod). 1/true/yes/on => open signups
                                 # Local conformance --auth-signup needs this OPEN (1).
AUTH_DEMO_SEED=                  # email:password local convenience seed (avoid on prod DB)
AUTH_ADMIN_EMAILS=               # comma-separated admin allowlist (shared AI key allowance)
AUTH_APP_POST_LOGIN_URL=         # ( / ) post-OAuth redirect path

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# =============================================================================
# E. Operator / security
# =============================================================================
METRICS_SECRET_TOKEN=            # unset => /api/_metrics open (dev). *** SET IN PROD ***
PUBLIC_RATE_LIMIT_PER_MIN=       # (120) per-IP; 0 disables
ALLOWED_ORIGINS=                 # CORS; unset => deny-all (OK when Pages Function same-origin)
                                 # local if needed: http://localhost:4200
ENABLE_API_DOCS=                 # residual/docs flag; keep off in prod
MAX_LIVE_SESSIONS=               # capacity ceilings (see prior security notes)
MAX_LIVE_SUBSCRIBERS=

# Dark pool / blocks (bundle context; best-effort)
INCLUDE_DARK_POOL=               # (true)
DARKPOOL_LOOKBACK_SECONDS=       # (3600)
BLOCK_MIN_SHARES=                # (5000)

# Observability toggles (if present in residual paths)
OBSERVABILITY_ENABLED=
METRICS_WINDOW_SIZE=
METRICS_RECENT_TRACES=

# =============================================================================
# F. AI recommendations (server-side only)
# =============================================================================
ANTHROPIC_API_KEY=               # shared server key (admin path); users may BYO encrypted
AI_REC_MODEL=
AI_REC_IN_APP_ENABLED=           # (true)
AI_REC_LOCAL_ONLY=               # restrict providers for locked-down hosts
# OPENAI_API_KEY= / XAI_API_KEY= / GEMINI_API_KEY=  — alternate shared providers if configured

# =============================================================================
# G. Broker (read-only positions; [no-real-order-path])
# =============================================================================
POSITIONS_PROVIDER=              # stub | webull | … (see broker module)
STUB_BROKER_BOOK=                # fixture arm for stub provider
BROKER_BOOK_TTL_SECONDS=
BROKER_STALE_AFTER_SECONDS=
BROKER_REFRESH_MIN_INTERVAL_SECONDS=
# Webull open-api (only when using that adapter; never commit real keys)
# WEBULL_APP_KEY=
# WEBULL_APP_SECRET=

# =============================================================================
# H. Research CLIs (P0 join-outcomes · P2 score-lab) — operator checklist
# =============================================================================
# These are the same env vars as serve; listed here so research is not tribal knowledge.
#
# 1) Confirm samples exist (prod or local):
#      curl -sS $API/api/health | jq .scanner.board.history_samples
#      curl -sS $API/api/scan/SPY/history?limit=5
#    Non-zero history_samples AND non-empty samples[] for target symbols.
#    (Known anomaly risk: count > 0 but history[] empty — investigate Postgres read path.)
#
# 2) join-outcomes (NEEDS Massive + store with samples):
#      cargo run -p api-rust --features postgres -- join-outcomes --symbols SPY,QQQ
#    Requires:
#      MASSIVE_API_KEY          — daily aggs for labels
#      SCAN_STORE=postgres      — if samples live in prod Postgres
#      DATABASE_URL or SCAN_DATABASE_URL
#      binary with --features postgres for PG store
#    Writes: data/research/outcomes_<utc>.json
#
# 3) score-lab (NO Massive once outcomes file exists):
#      cargo run -p api-rust -- score-lab --outcomes data/research/outcomes_….json --horizon 1d
#    Reads structure samples again from the same scan store (or --samples JSON).
#
# Prefer APP_ENV=test or a read-only DB role for research against a copy of prod
# history — never point a laptop `serve` at prod with open registration.

# =============================================================================
# I. Suggested profiles (copy blocks into real gitignored files)
# =============================================================================
# --- apps/api/.env  (APP_ENV=dev) ---
# APP_ENV=dev
# MASSIVE_API_KEY=...
# HTTP_BIND=127.0.0.1:8000
# AUTH_COOKIE_SECURE=0
# AUTH_REGISTRATION_OPEN=1
# SCAN_STORE=disk
# SCAN_MARKET_HOURS_ONLY=0          # optional: capture samples outside RTH while building research
# WARM_ENABLED=1
# PUBLIC_RATE_LIMIT_PER_MIN=0
# METRICS_SECRET_TOKEN=             # leave open locally
#
# --- apps/api/.env.test (APP_ENV=test) ---
# APP_ENV=test
# MASSIVE_API_KEY=...               # or fixture/mocks when available
# AUTH_REGISTRATION_OPEN=1          # interface_conformance --auth-signup
# AUTH_DEMO_SEED=qa@example.com:test-password-not-for-prod
# SCAN_STORE=disk
# SCAN_STORE_PATH=data/test/scan.sqlite3
# DATABASE_URL=                     # optional separate test Postgres — NEVER prod URL
# PUBLIC_RATE_LIMIT_PER_MIN=0
# AI_REC_IN_APP_ENABLED=0           # unless testing AI path
#
# --- Railway / prod variable group (APP_ENV=prod) ---
# APP_ENV=prod
# MASSIVE_API_KEY=...
# DATABASE_URL=...
# SCAN_STORE=postgres
# AUTH_SESSION_SIGNING_KEY=...      # stable
# AI_KEY_ENCRYPTION_KEY=...         # stable
# AUTH_COOKIE_SECURE=1
# AUTH_REGISTRATION_OPEN=0          # closed unless intentionally open
# METRICS_SECRET_TOKEN=...
# PUBLIC_RATE_LIMIT_PER_MIN=30
# ALLOWED_ORIGINS=                  # usually unset (Pages Function same-origin)
# DATA_FEED=realtime
# SCAN_MARKET_HOURS_ONLY=1
