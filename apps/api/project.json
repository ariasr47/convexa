{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "tags": ["scope:backend", "type:app", "status:retired"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"console.error('Python api is RETIRED — use: npm run serve:api  (api-rust)'); process.exit(1)\""
      },
      "cache": false
    },
    "serve-python-legacy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": ".venv\\Scripts\\python.exe main.py"
      },
      "cache": false
    },
    "serve-worker-legacy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": ".venv\\Scripts\\python.exe worker.py"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": ".venv\\Scripts\\python.exe -m pytest"
      },
      "cache": false
    }
  }
}
