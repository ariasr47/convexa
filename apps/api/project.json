{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p api-rust --features postgres -- serve",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "api-contract-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/api-contract.mjs check",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p api-rust --release",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "cargo build -p api-rust"
        },
        "production": {
          "command": "cargo build -p api-rust --release --features postgres"
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["api-contract-check"],
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["api-contract-check"],
      "options": {
        "command": "cargo test -p api-rust -p quant-engine",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/libs/quant-engine/**/*",
        "{workspaceRoot}/libs/api/src/generated/**/*",
        "{workspaceRoot}/libs/api/package.json",
        "{workspaceRoot}/apps/dashboard/src/**/*",
        "{workspaceRoot}/.spire/clusters/tech/contracts/production-runtime-guardrails/conformance-receipt.json",
        "{workspaceRoot}/.spire/clusters/tech/contracts/_archive/production-runtime-guardrails/conformance-receipt.json",
        "{workspaceRoot}/.spire/clusters/tech/state/conformance/production-runtime-guardrails-transport.json",
        "{workspaceRoot}/docs/ENVIRONMENTS.md",
        "{workspaceRoot}/docs/production-runtime-guardrails.md",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        { "runtime": "rustc --version" }
      ]
    },
    "capacity-baseline": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo run -p api-rust -- capacity-baseline", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "capacity-baseline-extended": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo run -p api-rust -- capacity-baseline --profile extended", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "capacity-baseline-self-test-connector-poison": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo run -p api-rust -- capacity-baseline self-test --case connector-poison", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "capacity-baseline-self-test-optional-fault": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo run -p api-rust -- capacity-baseline self-test --case optional-fault", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "capacity-baseline-self-test-byte-identity": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo run -p api-rust -- capacity-baseline self-test --case byte-identity", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "capacity-load": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p api-rust --locked --release -- capacity load",
        "cwd": "{workspaceRoot}",
        "env": {
          "APP_ENV": "dev"
        }
      },
      "cache": false
    },
    "capacity-soak": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p api-rust --locked -- capacity soak",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    }
  }
}
