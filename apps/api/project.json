{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p api-rust --features postgres -- serve",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "api-contract-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/api-contract.mjs check",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p api-rust --release",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "cargo build -p api-rust"
        },
        "production": {
          "command": "cargo build -p api-rust --release --features postgres"
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["api-contract-check"],
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["api-contract-check"],
      "options": {
        "command": "cargo test -p api-rust -p quant-engine",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "capacity-load": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p api-rust --locked --release -- capacity load",
        "cwd": "{workspaceRoot}",
        "env": {
          "APP_ENV": "dev"
        }
      },
      "cache": false
    },
    "capacity-soak": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p api-rust --locked -- capacity soak",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    }
  }
}
