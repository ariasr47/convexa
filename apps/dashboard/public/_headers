# Cloudflare Pages security headers (static assets + SPA).
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Keep CSP conservative but workable: Vite-built SPA, same-origin /api proxy,
# Google Fonts not used (self-hosted), no third-party analytics scripts required.
# TradingView (2026-10-13, owner's choice): its widget loader from s3.tradingview.com, and the
# iframes it frames from its two widget hosts. Nothing else third-party; see
# apps/dashboard/src/app/pages/ticker/technical-analysis/tradingView.ts.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://s3.tradingview.com; frame-src https://www.tradingview-widget.com https://s.tradingview.com; connect-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests

# Do not cache the SPA shell aggressively — deploys should show new assets promptly.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public files with fixed names (no content hash): a changed file keeps its URL, so cache them but
# never `immutable`. Fonts for 30 days, so a font rewritten in place reaches a returning visitor
# within 30 days of the deploy that carries it. Pages applies a rule to every request it matches,
# including one for a missing file that falls back to the SPA shell (_redirects).
/fonts/*
  Cache-Control: public, max-age=2592000

# The share image and the favicons for a day.
/og-image.png
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
