{
  "name": "@convexa/dashboard",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": ["scope:frontend", "type:app"],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "VITE_DATA_MODE"
          },
          {
            "env": "ANALYZE"
          },
          {
            "runtime": "node --version"
          },
          "{workspaceRoot}/tools/build-dashboard.mjs",
          "{workspaceRoot}/tools/write-dashboard-routes.mjs",
          "{workspaceRoot}/tools/archive-sourcemaps.mjs",
          "{workspaceRoot}/tools/precompress-dashboard.mjs",
          "{workspaceRoot}/research/**/*",
          "{workspaceRoot}/tools/research-notes/notes.mjs",
          "{workspaceRoot}/tools/research-notes/vite-plugin.mjs"
        ],
        "outputs": ["{projectRoot}/dist", "{projectRoot}/sourcemaps-private/current"],
        "configurations": {
          "production": {
            "command": "vite build --mode production && node ../../tools/write-dashboard-routes.mjs && node ../../tools/archive-sourcemaps.mjs && node ../../tools/precompress-dashboard.mjs",
            "env": {
              "NODE_ENV": "production"
            }
          },
          "development": {
            "command": "vite build --mode development"
          }
        },
        "defaultConfiguration": "production"
      },
      "precompress": {
        "command": "node tools/precompress-dashboard.mjs"
      },
      "analyze": {
        "command": "node tools/analyze-dashboard.mjs"
      },
      "check-bundle": {
        "command": "node tools/check-dashboard-bundle.mjs"
      }
    }
  }
}
