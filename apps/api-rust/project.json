{
  "name": "api-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api-rust/src",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p api-rust -- serve",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p api-rust --release",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p api-rust -p quant-engine",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    }
  }
}
