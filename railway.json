{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/apps/api/**",
      "/libs/quant-engine/**",
      "/Cargo.toml",
      "/Cargo.lock",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["api-rust postgres-migrate"],
    "healthcheckPath": "/api/health"
  }
}
