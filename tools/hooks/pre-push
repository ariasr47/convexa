#!/bin/sh
# Pre-push: Nx lint and typecheck for the projects affected since the merge base with origin/main.
# Install once per clone: git config core.hooksPath tools/hooks. Skip once: git push --no-verify.
# The fuller local check (adds the affected tests) is `npm run verify`; CI is off (CLAUDE.md, CI mode).
# Release version first (CLAUDE.md "Versions"): a push to main is a release, and staging is
# fast-forwarded to main, so neither may deploy new code under a version that is already out. Git
# writes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. A push of
# main or staging reads the version from the root package.json at the pushed commit, not the
# working tree, and fails until that version is bumped when:
# - v<version> tags another commit. A push of the tagged commit itself passes.
# - (main only) The remote's main already carries the version at another commit: a release pushed
#   but not tagged yet, or tagged only on the remote. The remote sha is the one git passes, so
#   there is no network call; a remote commit not fetched here passes (git refuses that push
#   unless it is forced). Staging takes main's commits, so it gets a second commit at a version
#   only if main did.
# Tags, other branches and deletes (an all-zero local sha) pass. The check runs first, so nothing
# else reads stdin before it. With a terminal on stdin a person ran the hook, not git, and there
# are no refs, so it is skipped.
# Proof: tools/hooks/pre-push.spec.mjs, in `npm run test:tools`.
version_at() { # <commit>: the version in the root package.json there, or nothing
  git cat-file blob "$1:package.json" 2>/dev/null |
    node -e 'let v; try { v = JSON.parse(require("fs").readFileSync(0, "utf8")).version } catch {} if (typeof v === "string" && /^\S+$/.test(v)) console.log(v)'
}
if [ ! -t 0 ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    case $remote_ref in refs/heads/main | refs/heads/staging) ;; *) continue ;; esac
    case $local_sha in *[!0]*) ;; *) continue ;; esac
    version=$(version_at "$local_sha")
    if [ -z "$version" ]; then
      echo "pre-push: no version in the root package.json at $(git rev-parse --short "$local_sha"); not pushing $remote_ref." >&2
      exit 1
    fi
    tagged=$(git rev-parse -q --verify "refs/tags/v$version^{}")
    if [ -n "$tagged" ] && [ "$tagged" != "$local_sha" ]; then
      at=$(git rev-parse --short "$tagged")
      echo "pre-push: v$version already tags $at, so bump the root package.json version, or move the tag if $at was never pushed (see CLAUDE.md \"Versions\")." >&2
      exit 1
    fi
    [ "$remote_ref" = refs/heads/main ] || continue
    case $remote_sha in *[!0]*) ;; *) continue ;; esac
    [ "$remote_sha" != "$local_sha" ] || continue
    [ "$(version_at "$remote_sha")" = "$version" ] || continue
    echo "pre-push: the remote's main already carries version $version, at $(git rev-parse --short "$remote_sha"), so bump the root package.json version (see CLAUDE.md \"Versions\")." >&2
    exit 1
  done
fi
# Research notes next: milliseconds, and a bad note would otherwise only fail the Pages build.
node tools/research-notes/check.mjs || exit 1
base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD~1)
# Secrets: scan the commits this push adds, with the repo's .gitleaks.toml and .gitleaksignore.
# Fail closed. With GitHub Actions off (2026-10-15) this hook is the only scanner before GitHub, and
# the last committed key (1aac13ec) stayed live for three months until a CI scan found it.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed (brew install gitleaks); not pushing unscanned commits." >&2
  exit 1
fi
gitleaks git --no-banner --redact --log-opts="$base..HEAD" . || exit 1
NX_NO_CLOUD=true exec npx nx affected -t lint typecheck --base="$base"
