# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# compiled output
dist
tmp
out-tsc

# Private prod sourcemaps (emitted hidden, archived out of dist — never commit)
apps/dashboard/sourcemaps-private/

# Rust workspace
/target/
**/target/
libs/**/Cargo.lock

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings
/design_handoff_convexa_redesign
/figma_frames

# System Files
.DS_Store
Thumbs.db

# Nx
.nx/cache
.nx/workspace-data
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
.cursor/rules/nx-rules.mdc
# Nx may regenerate GitHub agent skill stubs; we only keep workflows/
.github/instructions/
.github/skills/
.github/agents/
.github/prompts/

# ---------------------------------------------------------------------------
# AI assistant local scaffolding (NOT source of truth for this repo)
#
# Committed host adapters (Spire Tech):
#   .claude/  .codex/  .grok/  — framework + host wiring
# Product memory lives only under .spire/clusters/tech/
#
# .agents/ is an Nx-generated *mirror* of skills for generic agents. We do not
# use it — keep ignored so regenerations never re-enter git.
# ---------------------------------------------------------------------------
.agents/
.gemini/
.cursor/
.opencode/

.claude/worktrees
.worktrees/
.claude/settings.local.json
vite.config.*.timestamp*
vitest.config.*.timestamp*
test-output

# Rust / API local secrets & runtime data
apps/api/.env
apps/api/.env.*
!apps/api/.env.example
apps/api/data/
/data/

# Python leftovers (archived under archive/api-python)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
archive/**/.venv/
archive/**/__pycache__/
archive/**/.pytest_cache/
archive/**/data/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# session scratch (QA/V10 raw evidence, never committed)
.tmp*
