{
  "_comment": "Anonymous public surface for CI / post-deploy smoke. Environment-independent envelope shapes only — never assert live scores or prices (vendor/time dependent). Auth-gated endpoints live in auth-gated.json. Since SEC-1 (2026-10-26) GET /api/scan, GET /api/scan/all and GET /api/scan/{symbol}/history are signed-in reads, because their dealer levels derive from the licensed options feed: this sweep asserts their signed-out 403 auth_required refusal, and their signed-in envelopes are in auth-gated.json.",
  "version": "1.0",
  "feature": "public-surface",
  "endpoints": [
    {
      "id": "health_ok",
      "method": "GET",
      "path": "/api/health",
      "required": {
        "status": "string",
        "service": "string",
        "durable_store": "string",
        "scanner": "object",
        "scanner.enabled": "boolean",
        "scanner.universe_size": "number"
      }
    },
    {
      "id": "scan_signed_out_refused",
      "method": "GET",
      "path": "/api/scan",
      "expect_status": 403,
      "required": {
        "error": "string",
        "message": "string"
      }
    },
    {
      "id": "scan_all_signed_out_refused",
      "method": "GET",
      "path": "/api/scan/all",
      "expect_status": 403,
      "required": {
        "error": "string",
        "message": "string"
      }
    },
    {
      "id": "scan_universe_list",
      "method": "GET",
      "path": "/api/scan/universe",
      "required": {
        "symbols": "array",
        "universe_size": "number"
      }
    },
    {
      "id": "structure_history_signed_out_refused",
      "method": "GET",
      "path": "/api/scan/{symbol}/history",
      "path_params": { "symbol": "SPY" },
      "query": { "limit": 3 },
      "expect_status": 403,
      "required": {
        "error": "string",
        "message": "string"
      }
    },
    {
      "id": "public_data_markets_envelope",
      "method": "GET",
      "path": "/api/public-data/markets",
      "expect_status": 200,
      "required": {
        "state": "string"
      }
    },
    {
      "id": "public_data_filings_envelope",
      "method": "GET",
      "path": "/api/public-data/filings",
      "expect_status": 200,
      "required": {
        "state": "string"
      }
    },
    {
      "id": "public_data_ticker_envelope",
      "method": "GET",
      "path": "/api/public-data/tickers/{ticker}",
      "path_params": { "ticker": "SPY" },
      "expect_status": 200,
      "required": {
        "state": "string"
      }
    }
  ]
}
