{
  "_comment": "Runnable (system-1) conformance spec for the AUTH-GATED surface — the endpoints every earlier spec explicitly omitted because the runner was cookieless (TECH_DEBT #12). Requires a session: run with --auth-signup (bootstraps a throwaway user via POST /api/auth/signup and replays its Set-Cookie on every endpoint marked 'auth': true) or --auth-cookie NAME=VALUE. Only statically-checkable, environment-INDEPENDENT shapes are asserted. The PUT ai-key probe mutates only the throwaway signup user's Anthropic credential slot and asserts the provider-bootstrap shape — never the key/ciphertext.",
  "version": "1.1",
  "feature": "auth-gated sweep (tech-debt #12)",
  "endpoints": [
    {
      "id": "scan_default_view_signed_in",
      "_note": "SEC-1 (2026-10-26): a signed-in read, since its rows carry dealer levels derived from the licensed options feed; signed out is the 403 public-surface.json asserts. Envelope only: rows may be [] and sweep null on a fresh or pre-worker boot.",
      "method": "GET",
      "path": "/api/scan",
      "auth": true,
      "required": {
        "view": "object",
        "view.source": "string",
        "view.symbols": "array",
        "view.sort": "object",
        "view.density": "string",
        "view.authenticated": "boolean",
        "rows": "array",
        "sweep": "object|null",
        "market_data": "string"
      }
    },
    {
      "id": "scan_all_signed_in",
      "_note": "SEC-1 (2026-10-26): the whole universe ranked by score, signed in only. Envelope only, as scan_default_view_signed_in.",
      "method": "GET",
      "path": "/api/scan/all",
      "auth": true,
      "required": {
        "view": "object",
        "view.source": "string",
        "view.symbols": "array",
        "view.sort": "object",
        "view.density": "string",
        "view.authenticated": "boolean",
        "rows": "array",
        "sweep": "object|null",
        "market_data": "string"
      }
    },
    {
      "id": "structure_history_signed_in",
      "_note": "SEC-1 (2026-10-26): each sample carries the flip, the walls and net GEX, so the structure path is signed in only. samples may be [] on a cold store.",
      "method": "GET",
      "path": "/api/scan/{symbol}/history",
      "path_params": { "symbol": "SPY" },
      "query": { "limit": 3 },
      "auth": true,
      "required": {
        "symbol": "string",
        "samples": "array",
        "basis": "string",
        "stored_count": "number",
        "backend": "string"
      }
    },
    {
      "id": "settings_read_signed_in",
      "_note": "INTERFACE user-accounts §2.6 — 401 anonymous, 200 bag signed-in. Default-created on first read; all three prefs nullable.",
      "method": "GET",
      "path": "/api/auth/settings",
      "auth": true,
      "required": {
        "active_persona_id": "string|null",
        "default_ticker": "string|null",
        "theme": "string|null"
      }
    },
    {
      "id": "ai_key_hint_read_signed_in",
      "_note": "ai-providers bootstrap read — provider slots, Grok status, preference, catalog, and storage availability; NEVER a key or ciphertext.",
      "method": "GET",
      "path": "/api/auth/ai-key",
      "auth": true,
      "required": {
        "storage_available": "boolean",
        "providers": "array",
        "providers[].provider": "string",
        "providers[].set": "boolean",
        "providers[].last4": "string|null",
        "grok.available": "boolean",
        "grok.connected": "boolean",
        "grok.unavailable_reason": "string|null",
        "preference.power_path": "string|null",
        "preference.provider": "string|null",
        "preference.model": "string|null",
        "catalog.providers": "array",
        "catalog.providers[].provider": "string",
        "catalog.providers[].models": "array",
        "catalog.providers[].models[].id": "string",
        "catalog.providers[].models[].recommended": "boolean",
        "catalog.grok_subscription.provider": "string",
        "catalog.grok_subscription.models": "array",
        "catalog.grok_subscription.models[].id": "string",
        "catalog.grok_subscription.models[].recommended": "boolean"
      }
    },
    {
      "id": "ai_key_put_masked_echo",
      "_note": "ai-providers PUT stores one closed provider slot and returns the same secret-free bootstrap shape. Mutates the throwaway user only.",
      "method": "PUT",
      "path": "/api/auth/ai-key",
      "auth": true,
      "body": {
        "key": "sk-conformance-throwaway-00000000",
        "provider": "anthropic"
      },
      "required": {
        "storage_available": "boolean",
        "providers": "array",
        "providers[].provider": "string",
        "providers[].set": "boolean",
        "providers[].last4": "string|null",
        "grok.available": "boolean",
        "grok.connected": "boolean",
        "grok.unavailable_reason": "string|null",
        "preference.power_path": "string|null",
        "preference.provider": "string|null",
        "preference.model": "string|null",
        "catalog.providers": "array",
        "catalog.providers[].provider": "string",
        "catalog.providers[].models": "array",
        "catalog.providers[].models[].id": "string",
        "catalog.providers[].models[].recommended": "boolean",
        "catalog.grok_subscription.provider": "string",
        "catalog.grok_subscription.models": "array",
        "catalog.grok_subscription.models[].id": "string",
        "catalog.grok_subscription.models[].recommended": "boolean"
      }
    },
    {
      "id": "sim_trade_gate_signed_in",
      "_note": "positions write gate (ARCHITECTURE §8a; [server-side-gate-enforcement] canon) — 403 anonymous, 200 {authorized:true} with a session. The signed-in 200 arm was previously unverifiable by this tool.",
      "method": "POST",
      "path": "/api/positions/sim-trade/gate",
      "auth": true,
      "required": {
        "authorized": "boolean"
      }
    }
  ]
}
