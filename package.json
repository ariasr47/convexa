{
  "name": "@convexa/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p api,@convexa/dashboard",
    "serve:api": "nx serve api",
    "serve:dashboard": "nx serve @convexa/dashboard",
    "build": "npm run api:contract:check && npm run build:targets",
    "build:targets": "nx run-many -t build -p api,@convexa/dashboard --configuration=production",
    "build:dev": "nx run-many -t build -p api,@convexa/dashboard --configuration=development",
    "build:prod": "npm run build",
    "build:dashboard": "node tools/build-dashboard.mjs",
    "build:dashboard:demo": "node tools/build-dashboard.mjs --mode=demo",
    "research:check": "node tools/research-notes/check.mjs",
    "research:due": "node tools/research-notes/due.mjs",
    "research:new": "node tools/research-notes/new.mjs",
    "build:api": "nx build api --configuration=production",
    "analyze:dashboard": "node tools/analyze-dashboard.mjs",
    "check:bundle": "node tools/check-dashboard-bundle.mjs",
    "precompress:dashboard": "node tools/precompress-dashboard.mjs",
    "archive:sourcemaps": "node tools/archive-sourcemaps.mjs",
    "typecheck": "nx run-many -t typecheck -p @convexa/dashboard,@convexa/api",
    "test:targets": "nx run-many -t test -p @convexa/dashboard,@convexa/api,api",
    "test": "npm run test:targets && npm run capacity:baseline:self-test:connector-poison && npm run capacity:baseline:self-test:optional-fault && npm run capacity:baseline:self-test:byte-identity && npm run capacity:baseline",
    "capacity:baseline": "nx run api:capacity-baseline --skip-nx-cache",
    "capacity:baseline:extended": "nx run api:capacity-baseline-extended --skip-nx-cache",
    "capacity:baseline:self-test:connector-poison": "nx run api:capacity-baseline-self-test-connector-poison --skip-nx-cache",
    "capacity:baseline:self-test:optional-fault": "nx run api:capacity-baseline-self-test-optional-fault --skip-nx-cache",
    "capacity:baseline:self-test:byte-identity": "nx run api:capacity-baseline-self-test-byte-identity --skip-nx-cache",
    "lint": "nx run-many -t lint -p @convexa/dashboard,@convexa/api,dashboard-e2e",
    "format": "prettier --write \"apps/dashboard/**/*.{ts,tsx,js,jsx,mjs,css,json,md}\" \"apps/dashboard-e2e/**/*.{ts,tsx,js,mjs,json}\" \"libs/**/*.{ts,tsx,js,mjs,json,md}\" \"tools/**/*.{js,mjs,ts}\" \"functions/**/*.{ts,js}\" \"*.{json,md,mjs,yml}\" --ignore-unknown",
    "format:check": "prettier --check \"apps/dashboard/**/*.{ts,tsx,js,jsx,mjs,css,json,md}\" \"apps/dashboard-e2e/**/*.{ts,tsx,js,mjs,json}\" \"libs/**/*.{ts,tsx,js,mjs,json,md}\" \"tools/**/*.{js,mjs,ts}\" \"functions/**/*.{ts,js}\" \"*.{json,md,mjs,yml}\" --ignore-unknown",
    "graph": "nx graph",
    "ports:free": "node tools/free-ports.mjs",
    "test:tools": "node tools/test-tools.mjs",
    "verify": "node tools/verify.mjs",
    "api:contract:baseline:candidate": "node tools/api-contract-baseline.mjs candidate",
    "api:contract:baseline:accept": "node tools/api-contract-baseline.mjs accept",
    "api:router-integration:baseline:candidate": "node tools/api-router-integration-baseline.mjs candidate",
    "api:router-integration:baseline:accept": "node tools/api-router-integration-baseline.mjs accept",
    "api:router-integration:candidate": "node tools/api-router-integration-baseline.mjs compare",
    "api:router-integration:rollback": "node tools/api-router-integration-rollback.mjs",
    "api:router-integration:compile-probe": "node tools/api-router-integration-compile-probe.mjs",
    "api:contract:generate": "node tools/api-contract.mjs generate",
    "api:contract:check": "node tools/api-contract.mjs check",
    "capacity:load": "nx run api:capacity-load --skip-nx-cache",
    "capacity:soak": "nx run api:capacity-soak --skip-nx-cache",
    "worktree:link": "node tools/link-workspace.mjs",
    "ci": "npm run api:contract:check && npm run ci:targets",
    "ci:targets": "npm run lint && npm run typecheck && npm run test && npm run build:targets && npm run check:bundle",
    "conformance:public": "node .claude/tools/interface_conformance.mjs --spec .spire/clusters/tech/state/conformance/public-surface.json --url",
    "conformance:scanner": "node .claude/tools/interface_conformance.mjs --spec .spire/clusters/tech/state/conformance/scanner.json --url",
    "conformance:auth": "node .claude/tools/interface_conformance.mjs --spec .spire/clusters/tech/state/conformance/auth-gated.json --auth-signup --url",
    "supply-chain:candidate": "node tools/supply-chain/bootstrap-candidate.mjs",
    "supply-chain:toolchain": "node tools/supply-chain/toolchain.mjs",
    "supply-chain:policy": "node tools/supply-chain/policy.mjs",
    "supply-chain:artifacts": "node tools/supply-chain/artifacts.mjs",
    "supply-chain:poison": "node tools/supply-chain/capabilities.mjs",
    "supply-chain:verify": "node tools/supply-chain/verify.mjs",
    "browser:chromium": "nx run dashboard-e2e:e2e --skip-nx-cache",
    "browser:compat": "nx run dashboard-e2e:compat --skip-nx-cache",
    "browser:a11y": "nx run dashboard-e2e:a11y --skip-nx-cache",
    "browser:quality": "nx run dashboard-e2e:quality --skip-nx-cache"
  },
  "workspaces": ["apps/*", "libs/*"],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "^23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "^23.1.1",
    "@nx/react": "^23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@playwright/test": "^1.62.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jiti": "2.7.0",
    "jsdom": "^27.4.0",
    "jsonc-eslint-parser": "^2.4.2",
    "nx": "23.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rollup-plugin-visualizer": "7.0.1",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nx": {
      "brace-expansion": "5.0.9"
    },
    "postcss": {
      "nanoid": "3.3.18"
    },
    "qs": "^6.16.0",
    "fast-uri": "^4.1.4",
    "js-yaml": "5.4.1",
    "@redocly/openapi-core": {
      "js-yaml": "4.3.1"
    }
  }
}
