{
  "name": "@convexa/api",
  "version": "0.0.1",
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "nx": {
    "tags": ["scope:shared", "type:lib"],
    "targets": {
      "typecheck": {
        "dependsOn": ["^build", { "projects": "api", "target": "api-contract-check" }]
      },
      "test": {
        "dependsOn": ["^build", { "projects": "api", "target": "api-contract-check" }],
        "inputs": [
          "default",
          "^production",
          { "externalDependencies": ["vitest"] },
          "{workspaceRoot}/apps/api/src/services/auth/service.rs"
        ]
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract-authority": {
      "types": "./src/lib/contract-authority.ts",
      "import": "./src/lib/contract-authority.ts",
      "default": "./src/lib/contract-authority.ts"
    },
    "./package.json": "./package.json"
  }
}
